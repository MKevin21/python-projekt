      "cell_type": "code",
      "source": [
        "print(\"--- 5. KÉRDÉS: Értékvesztés tulajdonosok szerint a leggyakoribb márkáknál ---\")\n",
        "\n",
        "# 1. LÉPÉS: Dinamikusan megkeressük a 3 leggyakoribb autómárkát\n",
        "# A value_counts() rendezi gyakoriság szerint, a head(3) kiveszi az első hármat,\n",
        "# az .index.tolist() pedig csinál belőlük egy Python listát (pl. ['Maruti Suzuki', 'Hyundai', 'Honda'])\n",
        "top3_brands = df['Brand'].value_counts().head(3).index.tolist()\n",
        "\n",
        "# 2. LÉPÉS: Szűrés a top 3 márkára\n",
        "# Az .isin() csak azokat a sorokat tartja meg, amik benne vannak az előzőleg generált listában\n",
        "df_top3 = df[df['Brand'].isin(top3_brands)]\n",
        "\n",
        "# 3. LÉPÉS: Többszintű csoportosítás\n",
        "# Egyszerre csoportosítunk márka, kor ÉS tulajdonos szerint, majd átlagot vonunk az árból\n",
        "elemzes = df_top3.groupby(['Brand', 'Age', 'Owner'])['AskPrice'].mean().reset_index()\n",
        "\n",
        "# 4. LÉPÉS: Összetett többpaneles (facet) vonaldiagram Plotly-val\n",
        "fig5 = px.line(\n",
        "    elemzes,\n",
        "    x='Age',\n",
        "    y='AskPrice',\n",
        "    color='Owner',         # Külön vonal az első és második tulajdonosnak\n",
        "    facet_col='Brand',     # MINDEN MÁRKA KAP EGY KÜLÖN DIAGRAMOT egymás mellett\n",
        "    markers=True,          # Pontok megjelenítése a vonalakon\n",
        "    title='Értékvesztés a tulajdonosok száma alapján a 3 leggyakoribb márkánál',\n",
        "    labels={'Age': 'Autó kora (Év)', 'AskPrice': 'Átlagár (Rúpia)', 'Owner': 'Tulaj'},\n",
        "    color_discrete_map={'first': 'green', 'second': 'orange', 'third': 'red'}\n",
        ")\n",
        "\n",
        "# Bónusz profi beállítás: Engedjük, hogy a panelek Y-tengelyei alkalmazkodjanak a saját áraikhoz\n",
        "fig5.update_yaxes(matches=None)\n",
        "\n",
        "fig5.show()\n"
      ],
