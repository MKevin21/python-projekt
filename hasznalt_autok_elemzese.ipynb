    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import plotly.express as px\n",
        "import re\n",
        "\n",
        "# 1. LÉPÉS: Beolvasás a Drive-ról\n",
        "df = pd.read_csv('/content/drive/MyDrive/used_cars_dataset_v2.csv')\n",
        "\n",
        "# --- ADATTISZTÍTÁS ---\n",
        "df['kmDriven'] = df['kmDriven'].astype(str).str.replace(' km', '', regex=False)\n",
        "df['kmDriven'] = df['kmDriven'].str.replace(',', '', regex=False)\n",
        "df['kmDriven'] = pd.to_numeric(df['kmDriven'], errors='coerce')\n",
        "\n",
        "df['AskPrice'] = df['AskPrice'].astype(str).str.replace(r'[^\\d]', '', regex=True)\n",
        "df['AskPrice'] = pd.to_numeric(df['AskPrice'], errors='coerce')\n",
        "\n",
        "df = df.dropna(subset=['kmDriven', 'AskPrice'])\n",
        "\n",
        "# --- 1. KÉRDÉS: Kilométer és Ár kapcsolata ---\n",
        "print(\"--- 1. KÉRDÉS: Kilométer és Ár kapcsolata ---\")\n",
        "\n",
        "# Korreláció számítása (NumPy)\n",
        "korrelacio = np.corrcoef(df['kmDriven'], df['AskPrice'])[0, 1]\n",
        "print(f\"A korrelációs együttható a futott km és az ár között: {korrelacio:.2f}\")\n",
        "\n",
        "# Vizuális ábrázolás (Plotly Scatter Plot)\n",
        "fig1 = px.scatter(\n",
        "    df,\n",
        "    x='kmDriven',\n",
        "    y='AskPrice',\n",
        "    title='Használt autók ára a futott kilométer függvényében',\n",
        "    labels={'kmDriven': 'Futott kilométer (km)', 'AskPrice': 'Ár (Rúpia)'},\n",
        "    opacity=0.5,\n",
        "    color_discrete_sequence=['blue']\n",
        ")\n",
        "\n",
        "fig1.show()\n"
      ],
