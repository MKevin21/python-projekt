        "# Vizuális ábrázolás Plotly-val (Pontdiagram szín szerinti csoportosítással)\n",
        "fig4 = px.scatter(\n",
        "    df,\n",
        "    x='Age',\n",
        "    y='AskPrice',\n",
        "    color='Transmission', # Ez osztja szét a pontokat a váltó típusa alapján\n",
