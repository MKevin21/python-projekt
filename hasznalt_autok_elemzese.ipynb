      "cell_type": "code",
      "source": [
        "# Újra beolvassuk a Drive-ról a friss adatot\n",
        "df = pd.read_csv('/content/drive/MyDrive/used_cars_dataset_v2.csv')\n",
        "\n",
        "# --- KÖTELEZŐ ADATTISZTÍTÁS (hogy számolni lehessen vele) ---\n",
        "df['kmDriven'] = df['kmDriven'].astype(str).str.replace(' km', '', regex=False)\n",
        "df['kmDriven'] = df['kmDriven'].str.replace(',', '', regex=False)\n",
        "df['kmDriven'] = pd.to_numeric(df['kmDriven'], errors='coerce')\n",
        "\n",
        "df['AskPrice'] = df['AskPrice'].astype(str).str.replace(r'[^\\d]', '', regex=True)\n",
        "df['AskPrice'] = pd.to_numeric(df['AskPrice'], errors='coerce')\n",
        "df = df.dropna(subset=['kmDriven', 'AskPrice'])\n",
        "\n",
        "# --- 2. KÉRDÉS ELEMZÉSE ---\n",
        "print(\"--- 2. KÉRDÉS: Legdrágább márkák 5 évnél idősebb autóknál ---\")\n",
        "\n",
        "# Szűrés 5 évnél idősebb autókra\n",
        "df_old = df[df['Age'] > 5]\n",
        "\n",
        "# Csoportosítás, átlagár és top 5 kiválasztása\n",
        "top5_marka = df_old.groupby('Brand')['AskPrice'].mean().reset_index()\n",
        "top5_marka = top5_marka.sort_values(by='AskPrice', ascending=False).head(5)\n",
        "\n",
        "# Plotly oszlopdiagram\n",
        "fig2 = px.bar(\n",
        "    top5_marka,\n",
        "    x='Brand',\n",
        "    y='AskPrice',\n",
        "    title='Top 5 legdrágább autómárka (5 évnél idősebb járművek)',\n",
        "    labels={'Brand': 'Autómárka', 'AskPrice': 'Átlagos Ár (Rúpia)'},\n",
        "    color='Brand'\n",
        ")\n",
        "\n",
        "fig2.show()\n"
      ],
