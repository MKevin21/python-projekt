        "print(\"--- 3. KÉRDÉS: Üzemanyagtípusok megoszlása ---\")\n",
        "\n",
        "# 1. LÉPÉS: Kiszámoljuk, melyik üzemanyagból hány darab van a piacon\n",
        "# A value_counts() összeszámolja a kategóriákat, a reset_index() pedig táblázattá alakítja\n",
        "uzemanyag_adatok = df['FuelType'].value_counts().reset_index()\n",
        "\n",
        "# Hogy egyértelmű legyen, átnevezzük az oszlopokat\n",
        "uzemanyag_adatok.columns = ['FuelType', 'Darabszam']\n",
        "\n",
        "# 2. LÉPÉS: Vizuális ábrázolás Plotly-val (Kördiagram / Pie Chart)\n",
        "fig3 = px.pie(\n",
        "    uzemanyag_adatok,\n",
        "    names='FuelType',       # Melyik oszlop adja a kategóriákat (szeleteket)\n",
        "    values='Darabszam',     # Melyik oszlop adja a szeletek méretét\n",
        "    title='Használt autók megoszlása üzemanyagtípus szerint',\n",
        "    color_discrete_sequence=px.colors.qualitative.Pastel # Ízléses pasztell színek\n",
        ")\n",
        "\n",
        "# 3. LÉPÉS: Bónusz beállítás, hogy a diagramon belül látszódjon a százalék és a név is\n",
        "fig3.update_traces(textposition='inside', textinfo='percent+label')\n",
        "\n",
        "fig3.show()\n"
      ],
